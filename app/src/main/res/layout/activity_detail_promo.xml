<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:orientation="vertical"
    tools:context=".Voucher.DetailPromoActivity">

    <include
        android:id="@+id/layoutToolbar"
        layout="@layout/include_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Banner Visual Top Promo Kopi Kenangan -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="170dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_gradient_gold"
                    android:padding="18dp">

                    <ImageView
                        android:id="@+id/imgBannerLogo"
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:contentDescription="Logo Member+"
                        android:src="@drawable/logo_member"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvBadgeTop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_header_banner"
                        android:backgroundTint="@color/espresso"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:text="EKSKLUSIF MEMBER+"
                        android:textColor="@color/member_gold"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvBannerTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="12dp"
                        android:fontFamily="@font/outfit_bold"
                        android:text="Voucher Kopi Kenangan"
                        android:textColor="@color/espresso"
                        android:textSize="20sp"
                        app:layout_constraintEnd_toStartOf="@+id/imgBannerLogo"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvBadgeTop" />

                    <TextView
                        android:id="@+id/tvBannerSub"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="12dp"
                        android:text="Penukaran Poin Spesial Member+"
                        android:textColor="@color/espresso"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toStartOf="@+id/imgBannerLogo"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvBannerTitle" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card Informasi Voucher & Poin -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvNamaVoucher"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/outfit_bold"
                            android:text="Kopi Kenangan - Voucher Diskon Rp 25.000"
                            android:textColor="@color/espresso"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/tvBadgePoin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_header_banner"
                            android:backgroundTint="@color/coffee_brown"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="★ 2.500 Poin"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDeskripsiVoucher"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Berlaku untuk semua varian kopi di seluruh gerai Kopi Kenangan."
                        android:textColor="#666666"
                        android:textSize="13sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:background="#EEEEEE" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Saldo Poin Kamu"
                            android:textColor="#888888"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvSaldoKamu"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/outfit_bold"
                            android:text="7.450 Poin"
                            android:textColor="@color/espresso"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section Ketentuan & Aturan (ListView dengan SimpleAdapter) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/outfit_bold"
                android:text="Ketentuan &amp; Cara Penggunaan"
                android:textColor="@color/espresso"
                android:textSize="15sp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <ListView
                    android:id="@+id/lvSyaratKetentuan"
                    android:layout_width="match_parent"
                    android:layout_height="260dp"
                    android:divider="#EEEEEE"
                    android:dividerHeight="1dp"
                    android:padding="8dp"
                    android:scrollbars="vertical" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Tombol Konfirmasi Tukar Poin -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKonfirmasiTukar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/outfit_bold"
                android:text="Konfirmasi Tukar Poin"
                android:textColor="@color/white"
                android:textSize="16sp"
                app:backgroundTint="@color/coffee_brown"
                app:cornerRadius="12dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
