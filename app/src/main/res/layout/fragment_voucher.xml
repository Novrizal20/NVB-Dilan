                        app:layout_constraintEnd_toStartOf="@+id/cardVoucher6Tukar"
                        app:layout_constraintStart_toEndOf="@+id/cardVoucher6Icon"
                        app:layout_constraintTop_toBottomOf="@+id/cardVoucher6Merchant" />

                    <TextView
                        android:id="@+id/cardVoucher6Poin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="6dp"
                        android:text="★ 3.000 Poin"
                        android:textColor="@color/coffee_brown"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@+id/cardVoucher6Icon"
                        app:layout_constraintTop_toBottomOf="@+id/cardVoucher6Nama" />

                    <TextView
                        android:id="@+id/cardVoucher6Tukar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_header_banner"
                        android:backgroundTint="@color/coffee_brown"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="Tukar"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvVoucherKosong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="24dp"
                android:gravity="center"
                android:text="Voucher tidak ditemukan"
                android:textColor="#888888"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_header_banner"
                android:backgroundTint="#E8F5E9"
                android:padding="14dp"
                android:text="Daftar voucher di halaman ini masih berupa contoh."
                android:textColor="@color/espresso"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
