<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView
        android:id="@+id/imgOnboarding"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:contentDescription="Ilustrasi Onboarding"
        android:src="@drawable/logo_member" />

    <TextView
        android:id="@+id/tvOnboardingTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:fontFamily="@font/outfit_bold"
        android:gravity="center"
        android:text="Kumpulkan Poin Setiap Transaksi"
        android:textColor="@color/espresso"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/tvOnboardingDesc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="Dapatkan poin otomatis dan cashback 5% Gold Member di setiap pembelian kopi favorit."
        android:textColor="#666666"
        android:textSize="14sp" />
</LinearLayout>
